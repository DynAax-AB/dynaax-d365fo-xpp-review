+			<Method>
+				<Name>expireRatings</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Expires ratings older than the cut-off date, and ratings for blocked vendors.
+    /// </summary>
+    public void expireRatings(TransDate _cutOff)
+    {
+        CONVendorRating rating;
+        VendTable       vendTable;
+
+        while select forupdate rating
+            where rating.Status == CONRatingStatus::Active
+        {
+            vendTable = VendTable::find(rating.VendAccount);
+
+            if (rating.RatingDate < _cutOff || vendTable.Blocked == CustVendorBlocked::All)
+            {
+                ttsbegin;
+                rating.Status = CONRatingStatus::Expired;
+                rating.update();
+                ttscommit;
+            }
+        }
+    }
+
 ]]></Source>
