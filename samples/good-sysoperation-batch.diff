+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Parameters for expiring vendor ratings.
+/// </summary>
+[DataContractAttribute]
+final class CONExpireRatingsContract
+{
+    TransDate cutOff;
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>parmCutOff</Name>
+				<Source><![CDATA[
+    [DataMemberAttribute, SysOperationLabelAttribute(literalStr("@CON:CutOffDate"))]
