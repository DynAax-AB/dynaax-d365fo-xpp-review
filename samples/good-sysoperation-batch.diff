diff --git a/Metadata/ContosoExtensions/ContosoExtensions/AxClass/CONExpireRatingsController.xml b/Metadata/ContosoExtensions/ContosoExtensions/AxClass/CONExpireRatingsController.xml
new file mode 100644
index 0000000..c0281aa
--- /dev/null
+++ b/Metadata/ContosoExtensions/ContosoExtensions/AxClass/CONExpireRatingsController.xml
@@ -0,0 +1,45 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>CONExpireRatingsController</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Runs the expire vendor ratings job.
+/// </summary>
+final class CONExpireRatingsController extends SysOperationServiceController implements BatchRetryable
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>main</Name>
+				<Source><![CDATA[
+    public static void main(Args _args)
+    {
+        CONExpireRatingsController controller = new CONExpireRatingsController(
+            classStr(CONExpireRatingsService),
+            methodStr(CONExpireRatingsService, process),
+            SysOperationExecutionMode::Synchronous);
+
+        controller.parmDialogCaption("@CON:ExpireRatings");
+        controller.startOperation();
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>isRetryable</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Safe to retry: setting the same status again changes nothing.
+    /// </summary>
+    public boolean isRetryable()
+    {
+        return true;
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
diff --git a/Metadata/ContosoExtensions/ContosoExtensions/AxClass/CONExpireRatingsService.xml b/Metadata/ContosoExtensions/ContosoExtensions/AxClass/CONExpireRatingsService.xml
