+++ b/Metadata/ContosoExtensions/ContosoExtensions/AxClass/CONExpireRatingsService.xml
@@ -0,0 +1,28 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>CONExpireRatingsService</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Expires vendor ratings in batch.
+/// </summary>
+final class CONExpireRatingsService extends SysOperationServiceBase
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>process</Name>
+				<Source><![CDATA[
+    public void process(CONExpireRatingsContract _contract)
+    {
+        CONVendorRatingService ratingService = new CONVendorRatingService();
+
+        ratingService.expireRatings(_contract.parmCutOff());
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
