--- /dev/null
+++ b/Metadata/ContosoExtensions/ContosoExtensions/AxClass/SalesTableCON_Extension.xml
@@ -0,0 +1,34 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>SalesTableCON_Extension</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Contoso extension of SalesTable: delivery note check.
+/// </summary>
+[ExtensionOf(tableStr(SalesTable))]
+final class SalesTableCON_Extension
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>validateWrite</Name>
+				<Source><![CDATA[
+    public boolean validateWrite()
+    {
+        boolean ret = next validateWrite();
+
+        if (ret && this.CONRequiresDeliveryNote && !this.CONDeliveryNote)
+        {
+            ret = checkFailed("@CON:DeliveryNoteRequired");
+        }
+
+        return ret;
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
