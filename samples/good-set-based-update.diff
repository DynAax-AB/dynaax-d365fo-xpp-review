+			<Method>
+				<Name>expireRatings</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Expires ratings older than the cut-off date, and ratings for blocked vendors.
+    /// </summary>
+    public void expireRatings(TransDate _cutOff)
+    {
+        CONVendorRating rating;
+        VendTable       vendTable;
+
+        ttsbegin;
+
+        update_recordset rating
+            setting Status = CONRatingStatus::Expired
+            where rating.Status == CONRatingStatus::Active
+               && rating.RatingDate < _cutOff;
+
+        update_recordset rating
+            setting Status = CONRatingStatus::Expired
+            where rating.Status == CONRatingStatus::Active
+            exists join vendTable
+                where vendTable.AccountNum == rating.VendAccount
+                   && vendTable.Blocked == CustVendorBlocked::All;
+
+        ttscommit;
+    }
+
 ]]></Source>
