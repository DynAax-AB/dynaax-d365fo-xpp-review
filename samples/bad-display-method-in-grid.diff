new file mode 100644
index 0000000..bb2fa33
--- /dev/null
+++ b/Metadata/ContosoExtensions/ContosoExtensions/AxClass/CustTableCON_Extension.xml
@@ -0,0 +1,32 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>CustTableCON_Extension</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+[ExtensionOf(tableStr(CustTable))]
+final class CustTableCON_Extension
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>CONOpenBalance</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// The customer's balance in accounting currency.
+    /// </summary>
+    public display AmountMST CONOpenBalance()
+    {
+        CustTrans custTrans;
+
+        select sum(AmountMST) from custTrans
+            where custTrans.AccountNum == this.AccountNum;
+
+        return custTrans.AmountMST;
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
